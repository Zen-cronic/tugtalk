// Shared settings. Machine-local values (the synthetic connector key) live in the
// Git-ignored Secrets.xcconfig; copy Secrets.example.xcconfig to create it.
// xcconfig treats "//" as a comment, so the URL scheme is split with $(SLASH).
SLASH = /
COACH_API_BASE_URL = https:$(SLASH)$(SLASH)kaungzinhein--synthetic-coaching-connector-web.us-east.modal.run
COACH_API_TOKEN =
#include? "Secrets.xcconfig"
